{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-live-context-v1",
  "title": "GET /api/sessions/{session_id}/context for a certified live session (contract v1, Phase 34C)",
  "description": "Wave A ContextDTO plus the pending certification. Every number comes from the CertificationResult the session already computed for this step (V4_WIRING_SPEC section 10.1); nothing is re-certified or invented.",
  "type": "object",
  "required": ["recommendation", "snapshot", "allowed_override_actions", "simulated", "honesty", "source", "certified"],
  "properties": {
    "simulated": {"const": true},
    "source": {"const": "LIVE"},
    "certified": {
      "type": "object",
      "required": ["params_id", "timestep", "threshold", "futures_used", "looks", "recommendation", "why", "candidates", "alternatives", "note"],
      "additionalProperties": false,
      "properties": {
        "params_id": {"const": "v4-cert-test-v1"},
        "timestep": {"type": "integer", "minimum": 0},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "futures_used": {"type": "integer", "minimum": 0},
        "looks": {"type": "integer", "minimum": 0},
        "recommendation": {"$ref": "#/$defs/candidate"},
        "why": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "alternatives": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["action_key", "label", "verdict", "lower", "upper", "certified", "comparison"],
            "additionalProperties": false,
            "properties": {
              "action_key": {"type": "string"},
              "label": {"type": "string"},
              "verdict": {"enum": ["FEASIBLE", "INFEASIBLE", "UNDECIDED"]},
              "lower": {"type": ["number", "null"]},
              "upper": {"type": ["number", "null"]},
              "certified": {"type": "boolean"},
              "comparison": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        },
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["action_key", "label", "verdict", "lower", "upper", "successes", "n", "outcome_counts"],
      "additionalProperties": false,
      "properties": {
        "action_key": {"type": "string"},
        "label": {"type": "string"},
        "verdict": {"enum": ["FEASIBLE", "INFEASIBLE", "UNDECIDED", "ALWAYS_ALLOWED"]},
        "lower": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "upper": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "successes": {"type": "integer", "minimum": 0},
        "n": {"type": "integer", "minimum": 0},
        "outcome_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
