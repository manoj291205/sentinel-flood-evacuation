{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-hil-messages-v1",
  "title": "Sentinel HIL MQTT message bodies (contract v1)",
  "description": "Lane X Phase 28 (src/hil, hil/firmware). The 'schema' field selects the message type.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "shelter_id",
        "count",
        "sigma",
        "seq",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "occupancy-v1"
        },
        "device_id": {
          "type": "string"
        },
        "shelter_id": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sigma": {
          "type": "number",
          "minimum": 0
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "zone_id",
        "level_cm",
        "seq",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "water-level-v1"
        },
        "device_id": {
          "type": "string"
        },
        "zone_id": {
          "type": "string"
        },
        "level_cm": {
          "type": "number"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "cert_id",
        "cert_hash",
        "group_id",
        "zone_id",
        "shelter_id",
        "people",
        "edge_ids",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "vehicle-cmd-v1"
        },
        "cert_id": {
          "type": "string",
          "pattern": "^CERT-[0-9]{6}$"
        },
        "cert_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone_id": {
          "type": "string"
        },
        "shelter_id": {
          "type": "string"
        },
        "people": {
          "type": "integer",
          "minimum": 1
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "cert_id",
        "cert_hash",
        "group_id",
        "shelter_id",
        "people",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "admission-cmd-v1"
        },
        "cert_id": {
          "type": "string",
          "pattern": "^CERT-[0-9]{6}$"
        },
        "cert_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "shelter_id": {
          "type": "string"
        },
        "people": {
          "type": "integer",
          "minimum": 1
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "cert_id",
        "accepted",
        "reason",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ack-v1"
        },
        "device_id": {
          "type": "string"
        },
        "cert_id": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "OK",
            "UNKNOWN_CERT",
            "HASH_MISMATCH",
            "KIND_NOT_ACTUATABLE",
            "ACTION_MISMATCH",
            "MALFORMED"
          ]
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "kind",
        "uptime_s",
        "rssi_dbm",
        "firmware",
        "ts_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "status-v1"
        },
        "device_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "water_level",
            "shelter",
            "vehicle",
            "bridge",
            "simulated"
          ]
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        },
        "rssi_dbm": {
          "type": [
            "number",
            "null"
          ]
        },
        "firmware": {
          "type": "string"
        },
        "ts_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    }
  ]
}
