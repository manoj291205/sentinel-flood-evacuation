{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-decision-why-v1",
  "title": "Plain-language explanation of one suggestion (contract v1)",
  "description": "Exactly three short reasons derived from the gate result (Phase 34A: template rules over CandidateCertificate fields; never free-form model text).",
  "type": "object",
  "required": ["decision_id", "source", "title", "reasons", "certified_lower", "threshold", "futures_used"],
  "additionalProperties": false,
  "properties": {
    "decision_id": {"type": "string"},
    "source": {"enum": ["FIXTURE", "LIVE"]},
    "title": {"type": "string", "minLength": 1},
    "reasons": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "certified_lower": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "futures_used": {"type": "integer", "minimum": 0}
  }
}
